{
  "id": "./",
  "name": "StudyDesk \u2014 Personal Study Planner",
  "short_name": "StudyDesk",
  "description": "A local-first study planner with tasks, deadlines, timetable, calendar, revision plans and notes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#14141a",
  "theme_color": "#14141a",
  "categories": ["productivity", "education"],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
