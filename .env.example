# Copy to .env.local and adjust. Never commit .env.local (it is gitignored).

# Public URL of the deployed site. Used for <link rel="canonical">, the og:/twitter:
# tags and the manifest start_url, so a client can point the app at their own
# domain without editing index.html.
# Leave unset to fall back to the GitHub Pages URL.
VITE_SITE_URL=https://arun-v-p.github.io/StudyDesk/

# Override the Vite `base` path explicitly. Normally derived from GITHUB_REPOSITORY
# in CI, so you only need this for an unusual deployment.
# VITE_BASE=/StudyDesk/
